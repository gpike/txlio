# Supabase
# For hosted Supabase projects, set these explicitly.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For local Docker Supabase, run `npm run dev:local`.
# It injects runtime values from `supabase status -o env` and does not require
# checking local keys into this file.

# App
NEXT_PUBLIC_APP_URL=https://txlio.com
